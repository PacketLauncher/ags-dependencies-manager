@echo off
setlocal EnableExtensions DisableDelayedExpansion
cd /d "%~dp0"
set "BASE=%~dp0"
if "%BASE:~-1%"=="\" set "BASE=%BASE:~0,-1%"

:menu
cls
echo ==============================================
echo         AGS Dependencies Manager
echo ==============================================
echo.
echo Dependency folder: "%BASE%"
echo.
echo   1. Install Engine dependency environment variables for THIS folder
echo   2. Uninstall Engine dependencies variables for THIS folder
echo   3. Copy Editor dependencies for an AGS source directory
echo   4. Uninstall Editor dependencies from an AGS source directory
echo   5. Exit
 echo.
choice /C 12345 /N /M "Select [1-5]: "
if errorlevel 5 goto end
if errorlevel 4 goto editor_remove
if errorlevel 3 goto editor_install
if errorlevel 2 (set "ACTION=remove" & goto engine_run)
if errorlevel 1 (set "ACTION=install" & goto engine_run)

:engine_run
if not exist "%BASE%\SDL2\include\SDL.h" (
  echo.
 echo ERROR: SDL2\include\SDL.h not found.
 echo Put this BAT in the root of WinDevDependenciesVS.
  pause
  goto menu
)
if not exist "%BASE%\SDL_sound\src\SDL_sound.h" (
  echo.
 echo ERROR: SDL_sound\src\SDL_sound.h not found.
  pause
  goto menu
)
set "AGS_SDL_INCLUDE=%BASE%\SDL2\include"
set "AGS_SDL_SOUND_INCLUDE=%BASE%\SDL_sound\src"
set "AGS_SDL_LIB=%BASE%\SDL2\lib\x86"
set "AGS_SDL_SOUND_LIB=%BASE%\SDL_sound\lib\x86"
set "AGS_LIBOGG_LIB=%BASE%\Xiph\x86"
set "AGS_LIBTHEORA_LIB=%BASE%\Xiph\x86"
set "AGS_LIBVORBIS_LIB=%BASE%\Xiph\x86"
echo.
echo Action: %ACTION%
echo Only USER environment variables are affected.
echo Windows PATH is not modified.
echo.
for %%V in (AGS_SDL_INCLUDE AGS_SDL_SOUND_INCLUDE AGS_SDL_LIB AGS_LIBOGG_LIB AGS_LIBTHEORA_LIB AGS_LIBVORBIS_LIB AGS_SDL_SOUND_LIB) do (
  set "AGS_VAR_NAME=%%V"
  call :apply
)
echo.
echo Finished. Restart Visual Studio before building.
pause
goto menu

:apply
set "AGS_VAR_VALUE="
call set "AGS_VAR_VALUE=%%%AGS_VAR_NAME%%%"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$n=$env:AGS_VAR_NAME; $v=$env:AGS_VAR_VALUE; $old=[Environment]::GetEnvironmentVariable($n,'User'); if($env:ACTION -eq 'install') { [Environment]::SetEnvironmentVariable($n,$v,'User'); Write-Host ('Installed: ' + $n + ' = ' + $v) } elseif($old -eq $v) { [Environment]::SetEnvironmentVariable($n,$null,'User'); Write-Host ('Removed: ' + $n) } else { Write-Host ('Kept (not owned by this folder): ' + $n) }"
if errorlevel 1 echo ERROR updating %AGS_VAR_NAME%
exit /b

:editor_install
call :ask_source
if errorlevel 1 goto menu
if not exist "%BASE%\irrKlang\x86\irrKlang.NET4.dll" (
 echo ERROR: irrKlang\x86\irrKlang.NET4.dll not found in the dependency folder.
  pause
  goto menu
)
set "AGS_EDITOR_REFS=%AGS_SOURCE%\Editor\References"
set "AGS_EDITOR_MANIFEST=%AGS_EDITOR_REFS%\AGS_Dependencies_Manager.installed.txt"
echo.
echo Copying Editor dependencies into:
echo "%AGS_EDITOR_REFS%"
echo.
call :copy_one "x86" "irrKlang.NET4.dll" "irrKlang.NET4.dll"
call :copy_one "x86" "ikpMP3.dll" "ikpMP3.dll"
call :copy_one "x86" "ikpFlac.dll" "ikpFlac.dll"
call :copy_one "x64" "irrKlang.NET4.dll" "x64\irrKlang.NET4.dll"
call :copy_one "x64" "ikpMP3.dll" "x64\ikpMP3.dll"
call :copy_one "x64" "ikpFlac.dll" "x64\ikpFlac.dll"
echo.
echo AGS.Native.dll is generated by the AGS.Editor.Full solution, not copied here.
echo Existing DLLs are never overwritten. Only newly copied files are tracked.
echo Finished. Reload the Visual Studio solution before rebuilding.
pause
goto menu

:copy_one
set "AGS_COPY_FROM=%BASE%\irrKlang\%~1\%~2"
set "AGS_COPY_REL=%~3"
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $src=$env:AGS_COPY_FROM; $rel=$env:AGS_COPY_REL; $dest=Join-Path $env:AGS_EDITOR_REFS $rel; $manifest=$env:AGS_EDITOR_MANIFEST; if(-not (Test-Path -LiteralPath $src -PathType Leaf)) { Write-Host ('MISSING source: ' + $src); exit 0 }; if(Test-Path -LiteralPath $dest) { Write-Host ('SKIPPED existing: ' + $rel); exit 0 }; $dir=Split-Path -Parent $dest; New-Item -ItemType Directory -Force -Path $dir -ErrorAction Stop | Out-Null; Copy-Item -LiteralPath $src -Destination $dest -ErrorAction Stop; $hash=(Get-FileHash -LiteralPath $dest -Algorithm SHA256).Hash; Add-Content -LiteralPath $manifest -Value ($rel + [char]124 + $hash) -Encoding ASCII; Write-Host ('COPIED: ' + $rel)"
if errorlevel 1 echo ERROR copying %AGS_COPY_REL%
exit /b

:editor_remove
call :ask_source
if errorlevel 1 goto menu
set "AGS_EDITOR_REFS=%AGS_SOURCE%\Editor\References"
set "AGS_EDITOR_MANIFEST=%AGS_EDITOR_REFS%\AGS_Dependencies_Manager.installed.txt"
if not exist "%AGS_EDITOR_MANIFEST%" (
  echo.
 echo No installation manifest found. Nothing will be deleted.
 echo This manager only removes DLLs that it previously copied and recorded.
  pause
  goto menu
)
echo.
echo Only files copied by this manager and still matching their recorded
echo hashes will be deleted. Modified files will be kept.
echo.
choice /C YN /N /M "Proceed with uninstall? [Y/N]: "
if errorlevel 2 goto menu
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $root=$env:AGS_EDITOR_REFS; $manifest=$env:AGS_EDITOR_MANIFEST; $allowed=@('irrKlang.NET4.dll','ikpMP3.dll','ikpFlac.dll','x64\irrKlang.NET4.dll','x64\ikpMP3.dll','x64\ikpFlac.dll'); $remaining=@(); foreach($line in @(Get-Content -LiteralPath $manifest)) { $parts=$line.Split([char]124,2); if($parts.Count -ne 2) { $remaining+= $line; continue }; $rel=$parts[0]; $expected=$parts[1]; if($allowed -notcontains $rel) { $remaining+=$line; Write-Host ('KEPT unknown entry: '+$rel); continue }; $dest=Join-Path $root $rel; if(-not (Test-Path -LiteralPath $dest -PathType Leaf)) { Write-Host ('Already absent: '+$rel); continue }; $actual=(Get-FileHash -LiteralPath $dest -Algorithm SHA256).Hash; if($actual -ne $expected) { $remaining+=$line; Write-Host ('KEPT modified file: '+$rel); continue }; Remove-Item -LiteralPath $dest -ErrorAction Stop; Write-Host ('REMOVED: '+$rel) }; if($remaining.Count -eq 0) { Remove-Item -LiteralPath $manifest -Force } else { Set-Content -LiteralPath $manifest -Value $remaining -Encoding ASCII }"
if errorlevel 1 echo ERROR during uninstall. Check the output above.
echo.
echo AGS.Native.dll and pre-existing files are never removed.
pause
goto menu

:ask_source
set "AGS_SOURCE="
echo.
echo Paste or drag an AGS source folder here, then press Enter.
echo Example: C:\Users\YourName\Desktop\ags
set /p "AGS_SOURCE=AGS source folder: "
set "AGS_SOURCE=%AGS_SOURCE:"=%"
if not defined AGS_SOURCE (
 echo No folder supplied.
  pause
  exit /b 1
)
if not exist "%AGS_SOURCE%\Solutions\AGS.Editor.Full.sln" (
  echo.
 echo ERROR: Not an AGS source root: "%AGS_SOURCE%"
 echo Expected Solutions\AGS.Editor.Full.sln beneath the selected folder.
  pause
  exit /b 1
)
if not exist "%AGS_SOURCE%\Editor" (
 echo ERROR: Editor folder not found.
  pause
  exit /b 1
)
exit /b 0

:end
endlocal
